# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Environment: .env.* catches .env.local, .env.production etc.; the `!`
# exception only works below it (pinned by tests/test_gitignore.py)
.env
.env.*
!.env.example

# API Keys (never commit real keys)
data/api_keys.json

# Temp files
tmp/
*.tmp

# Tailwind standalone CLI (downloaded by scripts/build-tailwind.sh)
.tools/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Claude Code session data (worktrees, settings)
.claude/
.clone/

# Claude Code session transcripts
*-this-session-is-being-continued-*.txt

# Stray binary/image assets under docs/ (diagrams go in as *.svg, screenshots don't)
docs/*.jpg
docs/*.jpeg
docs/*.png

# Internal strategy / planning docs — not for the public repo
docs-internal/

# Compiled translation catalogues. The app compiles locale/*/LC_MESSAGES/
# messages.po in memory at startup (app/core/i18n.py); a committed .mo only
# produced merge conflicts.
locale/**/*.mo

# Claude Code project guide — local dev/server-ops context, not for public repo
/CLAUDE.md

# Every file in the browser engine is served and counted in its tree hash, so
# git must see all of them: no rule above (build/, tmp/, ...) may hide one.
!app/static/engine/**
